# --- Required ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# --- Docker image ---
REGISTRY=ghcr.io
OWNER=mangahue
TAG=latest

# --- Runtime ---
MANGAHUE_PYTHON=python
MANGAHUE_MODEL_THREADS=2
RUST_LOG=mangahue=info,tower_http=info

# --- Limits ---
DAILY_PAGE_LIMIT=100
TELEGRAM_MAX_PAGES=32

# --- Alerts ---
# Telegram chat ID where alerts/errors are sent (your personal chat ID)
ADMIN_CHAT_ID=

# --- Cleanup ---
# Auto-delete processed files older than this many hours
CLEANUP_AFTER_HOURS=24

# --- Worker ---
# Unique identifier for this worker instance
WORKER_ID=gpu-worker-1

# --- API ---
# Host port mapping for the API (change if 7878 is in use)
API_PORT=7878

# --- Models ---
# Host directory containing pretrained ONNX models
# The models/pretrained/manga-colorization-v2 subdirectory must exist here
MANGAHUE_MODEL_DIR=./models
