[Unit]
Description=MangaHue Python Bot
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mangahue_bot
EnvironmentFile=/opt/mangahue_bot/.env
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
ExecStart=/opt/mangahue_bot/venv/bin/python /opt/mangahue_bot/bot.py
Restart=always
RestartSec=30
MemoryMax=1200M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
