[Unit]
Description=MangaHue Pro Compact ONNX Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mangahue-pro
Group=mangahue-pro
WorkingDirectory=/opt/MangaHue-current
EnvironmentFile=/etc/mangahue/telegram.env
Environment=MANGAHUE_MODEL_THREADS=2
Environment=MANGAHUE_MODEL_TIMEOUT_SECONDS=180
# Inference is fully native (Rust ort backend): no Python needed for the
# main model. The ONNX Runtime shared library is installed system-wide
# (see "ldconfig -p | grep onnxruntime": /usr/local/lib/libonnxruntime.so).
# No ORT_DYLIB_PATH needed — the loader's default search path finds it.
Environment=TMPDIR=/run/mangahue-pro/tmp
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=MALLOC_ARENA_MAX=2
RuntimeDirectory=mangahue-pro
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -m 0700 /run/mangahue-pro/jobs /run/mangahue-pro/tmp
# Model-first purity tier: DDColor-FULL with the pure-model-v2 preset
# (model chroma preserved — low confidence bars, exact gain, model regions
# frozen against palette re-hueing, harmony gated to neutrals, face paint
# yields to real skin) + soft_cel_anime_v2 style (de-warmed finishing) +
# per-chapter palette feedback (each manga carries its own accent hues).
# Rollback is an atomic symlink change: point /opt/MangaHue-current at a
# previous directory under /opt/MangaHue-releases and restart this unit.
ExecStart=/opt/MangaHue-current/bin/mangahue-telegram --work-dir /var/lib/mangahue-pro/telegram --scratch-dir /run/mangahue-pro/jobs --scratch-limit-bytes 805306368 --delivery-format jpeg --jpeg-quality 95 --max-pages 100 --max-concurrent-jobs 1 --max-queued-jobs 16 --max-queued-jobs-per-chat 1 --daily-limit 0 --retention-hours 24 --batch-size 1 --model /opt/MangaHue/models/ddcolor-full/ddcolor-full-fp32.onnx --preset /opt/MangaHue-current/configs/engine.telegram-pure-model-v2.yaml --style /opt/MangaHue-current/configs/styles/soft_cel_anime_v2.yaml --palette-feedback --cache-dir /var/lib/mangahue-pro/cache
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryHigh=4G
MemoryMax=5G
MemorySwapMax=512M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/mangahue-pro /run/mangahue-pro

[Install]
WantedBy=multi-user.target
