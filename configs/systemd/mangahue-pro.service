[Unit]
Description=MangaHue Pro Compact ONNX Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/MangaHue-release
EnvironmentFile=/opt/MangaHue-release/runtime/telegram.env
Environment=MANGAHUE_MODEL_THREADS=2
Environment=MANGAHUE_MODEL_TIMEOUT_SECONDS=180
# Inference is fully native (Rust ort backend): no Python needed for the
# main model. The ONNX Runtime shared library is installed system-wide
# (see "ldconfig -p | grep onnxruntime": /usr/local/lib/libonnxruntime.so).
# No ORT_DYLIB_PATH needed — the loader's default search path finds it.
Environment=TMPDIR=/run/mangahue-pro/tmp
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=MALLOC_ARENA_MAX=2
RuntimeDirectory=mangahue-pro
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -m 0700 /run/mangahue-pro/jobs /run/mangahue-pro/tmp
# Model-first purity tier: DDColor-FULL with the pure-model-v2 preset
# (model chroma preserved — low confidence bars, exact gain, model regions
# frozen against palette re-hueing, harmony gated to neutrals, face paint
# yields to real skin) + soft_cel_anime_v2 style (de-warmed finishing) +
# per-chapter palette feedback (each manga carries its own accent hues).
# Rollback: --model /opt/MangaHue/models/manga-onnx/manga-colorize-fp16.onnx
#           --preset /opt/MangaHue-release/configs/engine.telegram-cpu.yaml
#           --style /opt/MangaHue-release/configs/styles/studio_anime.yaml
ExecStart=/opt/MangaHue-release/bin/mangahue-telegram --work-dir /var/lib/mangahue-pro/telegram --scratch-dir /run/mangahue-pro/jobs --scratch-limit-bytes 805306368 --delivery-format jpeg --jpeg-quality 95 --max-pages 100 --max-concurrent-jobs 2 --batch-size 1 --model /opt/MangaHue/models/ddcolor-full/ddcolor-full-fp32.onnx --preset /opt/MangaHue-release/configs/engine.telegram-pure-model-v2.yaml --style /opt/MangaHue-release/configs/styles/soft_cel_anime_v2.yaml --palette-feedback --cache-dir /var/lib/mangahue-pro/cache
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryHigh=4G
MemoryMax=5G
MemorySwapMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/mangahue-pro /run/mangahue-pro

[Install]
WantedBy=multi-user.target
