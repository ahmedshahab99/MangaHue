[Unit]
Description=MangaHue Pro Compact ONNX Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/MangaHue-release
EnvironmentFile=/opt/MangaHue-release/runtime/telegram.env
Environment=MANGAHUE_MODEL_THREADS=2
Environment=MANGAHUE_MODEL_TIMEOUT_SECONDS=180
# Inference is fully native (Rust ort backend): no Python needed for the
# main model. ORT_DYLIB_PATH points at the ONNX Runtime shared library
# (the existing venv provides it; remove the venv once libonnxruntime is
# installed system-wide).
Environment=ORT_DYLIB_PATH=/opt/MangaHue/.venv/lib/python3.11/site-packages/onnxruntime/capi/libonnxruntime.so
Environment=TMPDIR=/run/mangahue-pro/tmp
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=MALLOC_ARENA_MAX=2
RuntimeDirectory=mangahue-pro
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -m 0700 /run/mangahue-pro/jobs /run/mangahue-pro/tmp
ExecStart=/opt/MangaHue-release/bin/mangahue-telegram --work-dir /var/lib/mangahue-pro/telegram --scratch-dir /run/mangahue-pro/jobs --scratch-limit-bytes 805306368 --delivery-format jpeg --jpeg-quality 95 --max-pages 2016 --max-concurrent-jobs 1 --batch-size 1 --model /opt/MangaHue/models/manga-onnx/manga-colorize-fp16.onnx --preset /opt/MangaHue-release/configs/engine.telegram-cpu.yaml --style /opt/MangaHue-release/configs/styles/studio_anime.yaml --daily-limit 0
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryHigh=4G
MemoryMax=5G
MemorySwapMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/mangahue-pro /run/mangahue-pro

[Install]
WantedBy=multi-user.target
